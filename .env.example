# ============================================
# DESARROLLO LOCAL
# ============================================

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME=Sweet Grace
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend
NODE_ENV=development
PORT=3001
DEBUG=true

# Base de datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweet_grace_dev

# Redis (opcional, para sesiones/caché)
REDIS_URL=redis://localhost:6379

# ============================================
# STRIPE (Pagos)
# ============================================
STRIPE_SECRET_KEY=sk_test_xxx...
STRIPE_PUBLIC_KEY=pk_test_xxx...
STRIPE_WEBHOOK_SECRET=whsec_xxx...
STRIPE_PRODUCT_CATEGORY_ID=xxxxx

# ============================================
# EMAILS (Resend)
# ============================================
RESEND_API_KEY=re_xxx...
RESEND_FROM_EMAIL=noreply@sweetgrace.com
ADMIN_EMAIL=admin@sweetgrace.com

# ============================================
# ALMACENAMIENTO (Cloudflare R2 / S3)
# ============================================
AWS_REGION=auto
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=sweet-grace-uploads
AWS_S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# ============================================
# SEGURIDAD
# ============================================
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_EXPIRATION=7d
BCRYPT_ROUNDS=10

# ============================================
# PRODUCCIÓN (comentar en desarrollo)
# ============================================
# NEXT_PUBLIC_API_URL=https://api.sweetgrace.com
# NEXT_PUBLIC_SITE_URL=https://sweetgrace.com
# NODE_ENV=production
# DATABASE_URL=postgresql://user:pass@db-prod:5432/sweet_grace
