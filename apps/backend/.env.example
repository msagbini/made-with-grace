# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sweet_grace_dev"

# Server
NODE_ENV=development
PORT=3001
DEBUG=true

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (Emails)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@sweetgrace.com
ADMIN_EMAIL=admin@sweetgrace.com

# AWS/S3/R2
AWS_REGION=auto
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=sweet-grace-uploads
AWS_S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# Security
JWT_SECRET=your-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
BCRYPT_ROUNDS=10

# Redis
REDIS_URL=redis://localhost:6379
