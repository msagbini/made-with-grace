{
  "version": 2,
  "buildCommand": "npm run build --workspace=@sweet-grace/frontend",
  "installCommand": "npm install",
  "outputDirectory": "apps/frontend/.next",
  "env": {
    "NEXT_PUBLIC_SITE_NAME": "Sweet Grace"
  },
  "regions": ["iad1"],
  "functions": {
    "apps/frontend/**/*.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [],
  "redirects": [],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=10, stale-while-revalidate=59"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
